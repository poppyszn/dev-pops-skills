# Local dev env — copied to .env by `make docker-dev` (see Makefile).
# Values here target the Docker network; native `npm run dev` outside
# Docker should point at localhost instead.

DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_PORT=5432
REDIS_PORT=6379

API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

DATABASE_URL=postgresql://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379

NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
