# Deploy-time env catalog for docker/develop/compose.yml.
# git-sync-deploy-style workflows copy this to .env on the host
# automatically the first time they sync — it never overwrites an
# existing .env, so real secrets filled in by hand persist across
# deploys.

IMAGE_TAG=latest-develop

# Container-network hostnames, not localhost — these services talk to
# each other inside the compose network.
NEXT_PUBLIC_API_URL=http://api:4000
VITE_API_URL=http://api:4000

# Externally-managed infra — this stack has no postgres/redis containers
# of its own (see compose.yml's header comment).
DATABASE_URL=postgresql://app:app@your-managed-postgres-host:5432/app
REDIS_URL=redis://your-managed-redis-host:6379

API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
