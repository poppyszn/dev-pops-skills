# Copy to docker/production/.env on the server (name it .env, not env.production.example)
# and fill in real values. The deploy never creates this file: placeholder secrets
# must not boot in production, so preflight.sh stops the deploy while any
# <placeholder> remains. Keep .env out of git (the deploy runs `git clean`, which
# only spares ignored files).
#
# No database container runs here: DATABASE_URL must point at a managed Postgres.
#
# IMPORTANT: docker compose reads this file itself and interpolates ${VAR}
# references WITHIN its values, not only inside compose.yml. A literal `$` in a
# value (a bcrypt hash always has them, e.g. $2b$12$...) must be written as `$$`,
# or compose silently drops the part that looks like a variable name. Check with
#   docker compose --env-file .env config | grep <VAR>
# that the value round-tripped intact.

# App config (read by application code)

NODE_ENV=production
PORT=3000
# Public origin of the web app (scheme + host, no trailing slash). The api uses it for CORS.
WEB_ORIGIN=<https://app.your-domain.example>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
JWT_SECRET=<generate-a-strong-secret>

# Number of trusted reverse-proxy hops in front of the api. 1 when nginx on this
# host is the only proxy. 0 means the api trusts no X-Forwarded-For at all.
TRUST_PROXY_HOPS=1

# Add the application's own settings below, and a matching `require_line` /
# `forbid_pattern` in preflight.sh for any value that must never be wrong in
# production (a stage flag, a kill switch that must stay off).

# Docker-only (compose host port mapping, never read by application code)

API_PORT=3000
